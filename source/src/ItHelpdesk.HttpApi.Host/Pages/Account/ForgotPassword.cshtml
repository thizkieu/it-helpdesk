@page
@model Volo.Abp.Account.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quên mật khẩu - ItHelpdesk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
            body {
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #0f172a;
            }

            .auth-page-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

                .auth-page-wrapper::before {
                    content: '';
                    position: absolute;
                    border-radius: 50%;
                    width: 400px;
                    height: 400px;
                    background: rgba(244, 114, 182, 0.15);
                    top: -50px;
                    right: -100px;
                    filter: blur(60px);
                }

            .auth-glass-card {
                background: rgba(30, 41, 59, 0.7);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 24px;
                padding: 50px 40px;
                width: 100%;
                max-width: 420px;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

            .custom-input {
                width: 100%;
                background: rgba(15, 23, 42, 0.6);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 14px;
                padding: 14px 16px 14px 45px;
                color: #f8fafc;
                transition: all 0.3s;
            }

                .custom-input:focus {
                    background: rgba(15, 23, 42, 0.9);
                    border-color: #ec4899;
                    box-shadow: 0 0 0 4px rgba(244, 114, 182, 0.15);
                    outline: none;
                }

            .input-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

            .btn-submit {
                background: linear-gradient(135deg, #ec4899 0%, #c084fc 100%);
                color: white;
                border: none;
                border-radius: 24px;
                padding: 14px;
                font-weight: 700;
                width: 100%;
                margin-top: 20px;
                transition: all 0.3s ease;
            }

                .btn-submit:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 25px rgba(236, 72, 153, 0.4);
                }

            .back-link {
                color: #cbd5e1;
                text-decoration: none;
                font-size: 14px;
                transition: 0.2s;
            }

                .back-link:hover {
                    color: #f8fafc;
                }
    </style>
</head>
<body>
    <div class="auth-page-wrapper">
        <div class="auth-glass-card text-center">
            <div class="mb-4">
                <i class="fas fa-shield-alt fa-3x" style="color: #f472b6;"></i>
                <h4 class="text-white mt-3 fw-bold">Khôi phục mật khẩu</h4>
                <p class="text-muted small mt-2">Nhập email của bạn, chúng tôi sẽ gửi liên kết để đặt lại mật khẩu.</p>
            </div>

            <form method="post">
                <div class="form-group mb-3 position-relative text-start">
                    <i class="fas fa-envelope input-icon"></i>
                    <input asp-for="Email" class="custom-input" placeholder="Địa chỉ Email" required />
                </div>

                <button type="submit" class="btn-submit">GỬI LIÊN KẾT</button>
            </form>

            <div class="mt-4">
                <a href="/Account/Login" class="back-link"><i class="fas fa-arrow-left me-1"></i> Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</body>
</html>