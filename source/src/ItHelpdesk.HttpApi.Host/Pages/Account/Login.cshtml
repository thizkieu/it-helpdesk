@page
@model Volo.Abp.Account.Web.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập - ItHelpdesk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
            body {
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #0f172a; /* Đổi nền sang tông tối bí ẩn */
            }

            .auth-page-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

                /* Vòng sáng Neon nhạt tạo sự bí ẩn */
                .auth-page-wrapper::before {
                    content: '';
                    position: absolute;
                    border-radius: 50%;
                    z-index: 0;
                    width: 500px;
                    height: 500px;
                    background: rgba(192, 132, 252, 0.15);
                    top: -150px;
                    left: -100px;
                    filter: blur(60px);
                }

                .auth-page-wrapper::after {
                    content: '';
                    position: absolute;
                    border-radius: 50%;
                    z-index: 0;
                    width: 400px;
                    height: 400px;
                    background: rgba(236, 72, 153, 0.1);
                    bottom: -100px;
                    right: -50px;
                    filter: blur(60px);
                }

            .auth-container {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 100px;
                z-index: 1;
                max-width: 1100px;
                width: 100%;
                padding: 20px;
            }

            .auth-illustration {
                text-align: center;
                flex: 1;
                position: relative;
            }

            .robot-img {
                max-width: 380px;
                animation: floatRobot 4s ease-in-out infinite;
                filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.4));
            }

            @@keyframes floatRobot {
                0% {
                    transform: translateY(0px);
                }

                50% {
                    transform: translateY(-15px);
                }

                100% {
                    transform: translateY(0px);
                }
            }

            .auth-greeting {
                font-weight: 800;
                color: #f8fafc;
                font-size: 32px;
                line-height: 1.4;
                margin-top: 10px;
            }

            /* Glassmorphism Dark Mode */
            .auth-glass-card {
                background: rgba(30, 41, 59, 0.7);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 24px;
                padding: 50px 40px;
                width: 100%;
                max-width: 450px;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
            }

            .custom-input {
                width: 100%;
                background: rgba(15, 23, 42, 0.6);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 14px;
                padding: 14px 16px 14px 45px;
                font-size: 15px;
                color: #f8fafc;
                transition: all 0.3s;
            }

                .custom-input:focus {
                    background: rgba(15, 23, 42, 0.9);
                    border-color: #c084fc;
                    outline: none;
                    box-shadow: 0 0 0 4px rgba(192, 132, 252, 0.15);
                    color: #ffffff;
                }

                .custom-input::placeholder {
                    color: #64748b;
                }

            .input-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                z-index: 2;
            }

            .forgot-pwd {
                font-size: 13px;
                color: #c084fc;
                text-decoration: none;
                font-weight: 500;
                transition: color 0.2s;
            }

                .forgot-pwd:hover {
                    color: #f472b6;
                }

            /* Custom Checkbox Ghi nhớ tài khoản */
            .custom-checkbox .form-check-input {
                background-color: rgba(15, 23, 42, 0.6);
                border-color: rgba(255, 255, 255, 0.2);
                cursor: pointer;
            }

                .custom-checkbox .form-check-input:checked {
                    background-color: #c084fc;
                    border-color: #c084fc;
                }

            .custom-checkbox .form-check-label {
                color: #cbd5e1;
                cursor: pointer;
                user-select: none;
            }

            .btn-login {
                background: linear-gradient(135deg, #c084fc 0%, #ec4899 100%);
                color: white;
                border: none;
                border-radius: 24px;
                padding: 14px;
                font-weight: 700;
                letter-spacing: 0.5px;
                transition: all 0.3s ease;
                width: 100%;
                margin-top: 10px;
                box-shadow: 0 8px 20px rgba(236, 72, 153, 0.25);
            }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 25px rgba(236, 72, 153, 0.4);
                }
    </style>
</head>
<body>
    <div class="auth-page-wrapper">
        <div class="auth-container">
            <div class="auth-illustration d-none d-md-block">
                <div class="robot-wrapper">
                    <img src="http://localhost:4200/assets/images/login/ithelpdesk-robot.png" alt="Robot" class="robot-img" />
                </div>
                <h2 class="auth-greeting">Chào bạn đến với<br>hệ thống hỗ trợ!</h2>
            </div>

            <div class="auth-glass-card">
                <div class="text-center mb-4">
                    <img src="http://localhost:4200/assets/images/logo/ithelpdesk-logo.png" alt="ItHelpdesk" style="width: 200px;" />
                    <h5 class="text-white mt-3 fw-bold">Đăng Nhập</h5>
                </div>

                <form method="post" class="mt-4">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <input type="hidden" name="returnUrlHash" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger p-2 border-0 bg-danger bg-opacity-25 text-white" style="font-size: 13px; border-radius: 10px;">
                            Sai tài khoản hoặc mật khẩu!
                        </div>
                    }

                    <div class="form-group mb-3 position-relative">
                        <i class="fas fa-user input-icon"></i>
                        <input asp-for="LoginInput.UserNameOrEmailAddress" class="custom-input" placeholder="Tên đăng nhập" required />
                    </div>

                    <div class="form-group mb-3 position-relative">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="LoginInput.Password" type="password" class="custom-input" placeholder="Mật khẩu" required />
                    </div>

                    <!-- NÚT GHI NHỚ TÀI KHOẢN -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check custom-checkbox mb-0">
                            <input class="form-check-input" type="checkbox" asp-for="LoginInput.RememberMe" id="rememberMe">
                            <label class="form-check-label small" for="rememberMe">
                                Ghi nhớ tài khoản
                            </label>
                        </div>
                        <a href="/Account/ForgotPassword" class="forgot-pwd">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" name="Action" value="Login" class="btn-login">ĐĂNG NHẬP</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>