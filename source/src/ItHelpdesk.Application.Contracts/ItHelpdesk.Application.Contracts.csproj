<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\common.props" />
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<RootNamespace>ItHelpdesk</RootNamespace>
		<!-- Đã thêm dòng này để chặn cảnh báo bảo mật NU1903 -->
		<NoWarn>$(NoWarn);NU1903</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="LanguageImportExport\**" />
		<Compile Remove="Languages\**" />
		<Compile Remove="LanguageTexts\**" />
		<EmbeddedResource Remove="LanguageImportExport\**" />
		<EmbeddedResource Remove="Languages\**" />
		<EmbeddedResource Remove="LanguageTexts\**" />
		<None Remove="LanguageImportExport\**" />
		<None Remove="Languages\**" />
		<None Remove="LanguageTexts\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ItHelpdesk.Domain.Shared\ItHelpdesk.Domain.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Abp.AutoMapper" Version="10.5.0" />
		<PackageReference Include="AutoMapper" Version="14.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0-preview.7.26381.103" />
		<PackageReference Include="Volo.Abp.PermissionManagement.Application.Contracts" Version="10.7.0-rc.3" />
		<PackageReference Include="Volo.Abp.FeatureManagement.Application.Contracts" Version="10.7.0-rc.3" />
		<PackageReference Include="Volo.Abp.SettingManagement.Application.Contracts" Version="10.7.0-rc.3" />
		<PackageReference Include="Volo.Abp.Identity.Application.Contracts" Version="10.7.0-rc.3" />
		<PackageReference Include="Volo.Abp.Account.Application.Contracts" Version="10.7.0-rc.3" />
		<PackageReference Include="Volo.Abp.TenantManagement.Application.Contracts" Version="10.7.0-rc.3" />
	</ItemGroup>
</Project>