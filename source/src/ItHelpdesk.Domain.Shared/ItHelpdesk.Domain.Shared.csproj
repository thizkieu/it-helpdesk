<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ItHelpdesk</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Volo.Abp.BackgroundJobs.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.AuditLogging.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.SettingManagement.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.BlobStoring.Database.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.GlobalFeatures" Version="10.7.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.OpenIddict.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.Identity.Domain.Shared" Version="10.7.0-rc.3" />
    <PackageReference Include="Volo.Abp.TenantManagement.Domain.Shared" Version="10.7.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\ItHelpdesk\*.json" />
    <Content Remove="Localization\ItHelpdesk\*.json" />
  </ItemGroup>

</Project>
